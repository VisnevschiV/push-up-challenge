{
  "name": "push-up-challenge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync-wasm": "node -e \"const fs=require('fs');fs.mkdirSync('public/mediapipe',{recursive:true});fs.cpSync('node_modules/@mediapipe/tasks-vision/wasm','public/mediapipe',{recursive:true});\"",
    "predev": "npm run sync-wasm",
    "dev": "vite",
    "prebuild": "npm run sync-wasm",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.94.0",
    "typescript": "~7.0.2",
    "vite": "^8.4.0",
    "vite-plugin-pwa": "^2.0.0"
  }
}
